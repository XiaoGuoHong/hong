---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { pageUrl } from '../lib/paths';
import { isPublicProject, site } from '../lib/site';

const projects = (await getCollection('projects'))
  .filter((project) => isPublicProject(project.data))
  .sort((a, b) => a.data.order - b.data.order);

const description = site.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  sameAs: [site.github],
};
---

<Base title={site.name} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <p class="kicker"><span lang="en">Python / Go</span></p>
    <h1 lang="en">Hong</h1>
    <p class="lede">我是 Hong。这里只放已经公开、且可以单独公开的个人作品。</p>
    <p class="lede">
      关心 <span class="nowrap">AI Agent</span> 的工程架构，比如长会话里的上下文怎么管理，以及不靠框架把 agent 搭起来。本地桌面工具也是我常做的一类东西。
    </p>
    <p class="more"><a href={pageUrl('about')}>更多关于我</a></p>
  </section>

  <section aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">项目</h2>
    </div>
    {
      projects.length === 0 ? (
        <p class="lede">还没有可以公开的项目。</p>
      ) : (
        <ul class="wall">
          {
            projects.map((project) => (
              <li class:list={{ 'is-wide': project.data.kind === 'company' }}>
                <ProjectCard project={project} />
              </li>
            ))
          }
        </ul>
      )
    }
  </section>
</Base>
